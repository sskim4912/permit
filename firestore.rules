rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ICEik0y5U3aETq3mvW7sesAsNRB2';
    }
    function text(value) { return value is string && value.size() <= 200; }
    function valid(d) {
      return d.keys().hasAll(['visit_date','purpose','gate','name','birth','phone','plate','vehicle_type','vehicle_name','role','shoes','team','status','reviewer','version','created'])
        && d.keys().hasOnly(['visit_date','purpose','gate','name','birth','phone','plate','vehicle_type','vehicle_name','role','shoes','team','status','reviewer','version','created','delivery_at','visit_end_date','author_name','owner_key','modified_by','modified_at','team_id','lunch','gaisu_requested','gaisu_approved','final_approved'])
        && (!('delivery_at' in d) || (d.delivery_at is timestamp && d.delivery_at <= request.time))
        && ((!('author_name' in d) && !('owner_key' in d)) || (d.author_name is string && d.author_name.size() > 0 && d.author_name.size() <= 50 && d.owner_key is string && d.owner_key.matches('^[a-f0-9]{64}$')))
        && ((!('modified_by' in d) && !('modified_at' in d)) || (d.modified_by is string && d.modified_by.size() > 0 && d.modified_by.size() <= 50 && d.modified_at is timestamp && d.modified_at <= request.time))
        && d.visit_date is string && d.visit_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('visit_end_date' in d) || (d.visit_end_date is string && d.visit_end_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.visit_end_date >= d.visit_date))
        && d.birth is string && d.birth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && text(d.purpose) && d.purpose.size() > 0
        && text(d.name) && d.name.size() > 0
        && text(d.team) && d.team.size() > 0
        && text(d.phone) && d.phone.size() > 0
        && text(d.plate) && text(d.vehicle_type) && text(d.vehicle_name)
        && d.gate in ['서문','정문'] && d.role in ['운전자','동승자','도보']
        && d.shoes in ['필요없음','230','235','240','245','250','255','260','265','270','275','280','285','290','295','300']
        && d.status in ['승인 대기','현장 제출','현장 확인','발주처 제출','승인 완료']
        && d.reviewer is string && d.reviewer.size() <= 50
        && (!('team_id' in d) || (d.team_id is string && d.team_id.matches('^[a-zA-Z0-9_-]{1,60}$')))
        && (!('lunch' in d) || d.lunch in ['중식신청','미신청'])
        // New stamps are validated in keepStages; existing stamps must remain identical.
        && (!('final_approved' in d) || d.status == '승인 완료')
        && d.version is int && d.created is timestamp;
    }
    function publicData(d) {
      return ('visit_end_date' in d) ? {'visit_date':d.visit_date,'visit_end_date':d.visit_end_date,'purpose':d.purpose,'team':d.team,'status':d.status,'reviewer':d.reviewer,'version':d.version,'created':d.created} : {'visit_date':d.visit_date,'purpose':d.purpose,'team':d.team,'status':d.status,'reviewer':d.reviewer,'version':d.version,'created':d.created};
    }
    function previousRosterData(d) { return ('visit_end_date' in d) ? {'visit_date':d.visit_date,'purpose':d.purpose,'team':d.team,'status':d.status,'reviewer':d.reviewer,'version':d.version,'created':d.created,'name':d.name,'phone':d.phone,'plate':d.plate,'vehicle_type':d.vehicle_type,'vehicle_name':d.vehicle_name,'role':d.role,'shoes':d.shoes,'gate':d.gate,'birth_mask':(d.birth.matches('^19.*')?'19**-**-**':d.birth.matches('^20.*')?'20**-**-**':'****-**-**'),'visit_end_date':d.visit_end_date} : {'visit_date':d.visit_date,'purpose':d.purpose,'team':d.team,'status':d.status,'reviewer':d.reviewer,'version':d.version,'created':d.created,'name':d.name,'phone':d.phone,'plate':d.plate,'vehicle_type':d.vehicle_type,'vehicle_name':d.vehicle_name,'role':d.role,'shoes':d.shoes,'gate':d.gate,'birth_mask':(d.birth.matches('^19.*')?'19**-**-**':d.birth.matches('^20.*')?'20**-**-**':'****-**-**')}; }
    function rosterData(d) { return ('visit_end_date' in d) ? {'visit_date':d.visit_date,'purpose':d.purpose,'team':d.team,'status':d.status,'reviewer':d.reviewer,'version':d.version,'created':d.created,'name':d.name,'phone':d.phone,'plate':d.plate,'vehicle_type':d.vehicle_type,'vehicle_name':d.vehicle_name,'role':d.role,'shoes':d.shoes,'gate':d.gate,'lunch':d.get('lunch',''),'gaisu_requested':d.get('gaisu_requested',null),'gaisu_approved':d.get('gaisu_approved',null),'final_approved':d.get('final_approved',null),'birth_mask':(d.birth.matches('^19.*')?'19**-**-**':d.birth.matches('^20.*')?'20**-**-**':'****-**-**'),'visit_end_date':d.visit_end_date} : {'visit_date':d.visit_date,'purpose':d.purpose,'team':d.team,'status':d.status,'reviewer':d.reviewer,'version':d.version,'created':d.created,'name':d.name,'phone':d.phone,'plate':d.plate,'vehicle_type':d.vehicle_type,'vehicle_name':d.vehicle_name,'role':d.role,'shoes':d.shoes,'gate':d.gate,'lunch':d.get('lunch',''),'gaisu_requested':d.get('gaisu_requested',null),'gaisu_approved':d.get('gaisu_approved',null),'final_approved':d.get('final_approved',null),'birth_mask':(d.birth.matches('^19.*')?'19**-**-**':d.birth.matches('^20.*')?'20**-**-**':'****-**-**')}; }
    function matchesPublic(d,p) { return ('lunch' in p) ? p == rosterData(d) : ('birth_mask' in p) ? p == previousRosterData(d) : p == publicData(d); }
    function validStamp(stamp) {
      return stamp is map && stamp.keys().hasAll(['by','at']) && stamp.keys().hasOnly(['by','at'])
        && stamp.by is string && stamp.by.size() > 0 && stamp.by.size() <= 50 && stamp.at is timestamp && stamp.at <= request.time;
    }
    function keepStage(before, after, key, actor) {
      return (key in before) ? ((key in after) && after[key] == before[key])
        : (!(key in after) || (validStamp(after[key]) && after[key].by == actor && after[key].at == request.time));
    }
    function keepStages(before, after) {
      let actor = isAdmin() ? after.reviewer : before.get('author_name','');
      return keepStage(before,after,'gaisu_requested',actor) && keepStage(before,after,'gaisu_approved',actor)
        && keepStage(before,after,'final_approved',actor) && (isAdmin() || before.get('final_approved',null) == after.get('final_approved',null));
    }
    function ownerStage(before, after) {
      return ('owner_key' in before) && after.owner_key == before.owner_key && before.status != '승인 완료' && !('final_approved' in before)
        && after.diff(before).affectedKeys().hasOnly(['gaisu_requested','gaisu_approved','version','modified_by','modified_at'])
        && after.modified_by == before.author_name && after.modified_at == request.time;
    }
    function pending(d) { return d.status in ['승인 대기','현장 제출'] && !('delivery_at' in d); }
    function keepAuthor(before, after) {
      return (!('author_name' in before) || after.author_name == before.author_name)
        && (!('owner_key' in before) || after.owner_key == before.owner_key);
    }
    function ownerChange(before, after) {
      return ('owner_key' in before) && pending(before) && after.owner_key == before.owner_key
        && after.diff(before).affectedKeys().hasOnly(['visit_date','visit_end_date','purpose','team','gate','name','birth','phone','plate','vehicle_type','vehicle_name','role','shoes','lunch','team_id','version','modified_by','modified_at'])
        && after.modified_by == before.author_name && after.modified_at == request.time;
    }
    function deletedLog(id, before) {
      let log = getAfter(/databases/$(database)/documents/requestDeletions/$(id)).data;
      return log.owner_key == before.owner_key && log.version == before.version && log.actor_name == before.author_name && log.deleted_at == request.time;
    }
    match /requests/{id} {
      allow read: if isAdmin();
      allow create: if valid(request.resource.data)
        && !request.resource.data.keys().hasAny(['gaisu_requested','gaisu_approved','final_approved'])
        && request.resource.data.status in ['승인 대기','현장 제출']
        && !('delivery_at' in request.resource.data)
        && !('modified_at' in request.resource.data)
        && request.resource.data.reviewer == ''
        && request.resource.data.version == 1
        && request.resource.data.created == request.time
        && matchesPublic(request.resource.data,getAfter(/databases/$(database)/documents/publicRequests/$(id)).data);
      allow update: if (isAdmin() || ownerStage(resource.data,request.resource.data) || ownerChange(resource.data,request.resource.data)) && valid(request.resource.data)
        && keepAuthor(resource.data,request.resource.data)
        && keepStages(resource.data,request.resource.data)
        && (!('visit_end_date' in resource.data) || ('visit_end_date' in request.resource.data))
        && (!('delivery_at' in resource.data) || ('delivery_at' in request.resource.data))
        && (isAdmin() ? request.resource.data.reviewer.size() > 0 : request.resource.data.modified_by.size() > 0)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.created == resource.data.created
        && matchesPublic(request.resource.data,getAfter(/databases/$(database)/documents/publicRequests/$(id)).data);
      allow delete: if (isAdmin() || (pending(resource.data) && ('owner_key' in resource.data) && deletedLog(id,resource.data)))
        && !existsAfter(/databases/$(database)/documents/publicRequests/$(id));
    }
    match /publicRequests/{id} {
      // 공개 명단에는 요청된 방문정보와 마스킹된 생년월일만 저장하며 원본 생년월일·소유 키는 제외한다.
      allow read: if true;
      allow create: if matchesPublic(getAfter(/databases/$(database)/documents/requests/$(id)).data,request.resource.data)
        && getAfter(/databases/$(database)/documents/requests/$(id)).data.created == request.time;
      allow update: if matchesPublic(getAfter(/databases/$(database)/documents/requests/$(id)).data,request.resource.data);
      allow delete: if !existsAfter(/databases/$(database)/documents/requests/$(id));
    }
    // The unguessable browser key is a bearer credential, never stored in public summaries.
    match /applicantCopies/{key}/items/{id} {
      allow get, list: if key.matches('^[a-f0-9]{64}$');
      allow create, update: if key.matches('^[a-f0-9]{64}$')
        && request.resource.data.owner_key == key
        && request.resource.data == getAfter(/databases/$(database)/documents/requests/$(id)).data;
      allow delete: if isAdmin() || !existsAfter(/databases/$(database)/documents/requests/$(id));
    }
    match /requestDeletions/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['actor_name','deleted_at','author_name','owner_key','version'])
        && request.resource.data.actor_name is string && request.resource.data.actor_name.size() > 0 && request.resource.data.actor_name.size() <= 50
        && request.resource.data.deleted_at == request.time
        && (isAdmin() || (request.resource.data.owner_key == get(/databases/$(database)/documents/requests/$(id)).data.owner_key
          && request.resource.data.version == get(/databases/$(database)/documents/requests/$(id)).data.version
          && request.resource.data.author_name == get(/databases/$(database)/documents/requests/$(id)).data.author_name
          && request.resource.data.actor_name == get(/databases/$(database)/documents/requests/$(id)).data.author_name
          && pending(get(/databases/$(database)/documents/requests/$(id)).data)
          && !existsAfter(/databases/$(database)/documents/requests/$(id))));
    }
    function contact(c) { return c is map && c.keys().hasAll(['name','phone','email']) && c.keys().hasOnly(['name','phone','email']) && c.name is string && c.name.size()>0 && c.name.size()<=50 && c.phone is string && c.phone.matches('^01[016789]-[0-9]{3,4}-[0-9]{4}$') && c.email is string && c.email.size()<=254 && c.email.matches('^[^\\s@<>;,]+@[^\\s@<>;,]+[.][^\\s@<>;,]+$'); }
    match /contactTeams/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && id.matches('^[a-zA-Z0-9_-]{1,60}$') && request.resource.data.keys().hasAll(['name','order','contacts']) && request.resource.data.keys().hasOnly(['name','order','contacts']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=50 && request.resource.data.order is int && request.resource.data.order>=0 && request.resource.data.order<30 && request.resource.data.contacts is list && request.resource.data.contacts.size()==2 && contact(request.resource.data.contacts[0]) && contact(request.resource.data.contacts[1]);
      allow delete: if isAdmin();
    }
    match /settings/contactDirectory {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['version','modified_at']) && request.resource.data.version is int && request.resource.data.version == (resource == null ? 1 : resource.data.version+1) && request.resource.data.modified_at==request.time;
    }
    function queuedOriginal(id,key) { let original=getAfter(/databases/$(database)/documents/requests/$(id)).data; return id is string && original.owner_key==key && original.created==request.time && ('team_id' in original); }
    match /notificationQueue/{id} {
      allow read: if isAdmin();
      allow create: if id.matches('^[A-Za-z0-9]{20}$') && request.resource.data.keys().hasAll(['ids','owner_key','status','created']) && request.resource.data.keys().hasOnly(['ids','owner_key','status','created']) && request.resource.data.owner_key is string && request.resource.data.owner_key.matches('^[a-f0-9]{64}$') && request.resource.data.status=='pending' && request.resource.data.created==request.time && request.resource.data.ids is list && request.resource.data.ids.size()>0 && request.resource.data.ids.size()<=10 && request.resource.data.ids.toSet().size()==request.resource.data.ids.size()
        && (request.resource.data.ids.size()<=0 || queuedOriginal(request.resource.data.ids[0],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=1 || queuedOriginal(request.resource.data.ids[1],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=2 || queuedOriginal(request.resource.data.ids[2],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=3 || queuedOriginal(request.resource.data.ids[3],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=4 || queuedOriginal(request.resource.data.ids[4],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=5 || queuedOriginal(request.resource.data.ids[5],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=6 || queuedOriginal(request.resource.data.ids[6],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=7 || queuedOriginal(request.resource.data.ids[7],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=8 || queuedOriginal(request.resource.data.ids[8],request.resource.data.owner_key))
        && (request.resource.data.ids.size()<=9 || queuedOriginal(request.resource.data.ids[9],request.resource.data.owner_key))
        ;
    }
    match /applicantCopies/{key}/notificationReceipts/{id} { allow get: if key.matches('^[a-f0-9]{64}$'); }
    // Notification claims, results and rate limits are server-only.
    match /notificationJobs/{id} { allow read, write: if false; }
    match /notificationClaims/{id} { allow read, write: if false; }
    match /notificationLimits/{id} { allow read, write: if false; }
    match /settings/mail {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['recipient'])
        && request.resource.data.recipient is string
        && request.resource.data.recipient.size() <= 2540
        && request.resource.data.recipient.matches('^[^\\s@,;<>]+@[^\\s@,;<>]+[.][^\\s@,;<>]+(,[^\\s@,;<>]+@[^\\s@,;<>]+[.][^\\s@,;<>]+){0,9}$');
    }
  }
}
