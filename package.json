{
  "name": "permit-daesan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js --bundle --minify --outfile=public/app.js",
    "test": "firebase emulators:exec --project demo-permit --only firestore,auth 'node --test tests/firebase.test.js'",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules --project permit-daesan-461e8",
    "test:ui": "node --test tests/ui.test.js",
    "start": "python3 -m http.server 8000 --bind 127.0.0.1 --directory public"
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.2"
  }
}
